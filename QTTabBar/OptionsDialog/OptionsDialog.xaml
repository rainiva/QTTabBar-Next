<ui:FluentWindow

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:qt="clr-namespace:QTTabBarLib"

    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

    x:Class="QTTabBarLib.OptionsDialog"

    x:ClassModifier="internal"

    ExtendsContentIntoTitleBar="True"

    Height="680"

    MinHeight="520"

    MinWidth="860"

    Title="{qt:Resx Key=OptionsDialog, Index=0}"

    ToolTip="{qt:Resx Key=OptionsDialog, Index=0}"

    Width="960"

    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ui:ThemesDictionary Theme="Light"/>

                <ui:ControlsDictionary/>

                <ResourceDictionary Source="/QTTabBar;component/OptionsDialog/Themes/FluentTheme.Light.xaml"/>

                <ResourceDictionary Source="/QTTabBar;component/OptionsDialog/Themes/FluentControls.xaml"/>

                <ResourceDictionary Source="OptionsDialogResources.xaml"/>

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </ui:FluentWindow.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <ui:TitleBar Grid.Row="0" Title="{qt:Resx Key=OptionsDialog, Index=0}"/>



        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <Border

                Grid.Column="0"

                Background="{StaticResource Fluent.BackgroundLayer}"

                BorderBrush="{StaticResource Fluent.StrokeDefault}"

                BorderThickness="0,0,1,0">

                <ListBox

                    x:Name="lstCategories"

                    PreviewMouseWheel="lstCategories_PreviewMouseWheel"

                    SelectionMode="Single"

                    Style="{StaticResource FluentNavListBox}">

                    <ListBox.ItemContainerStyle>

                        <Style BasedOn="{StaticResource FluentNavListBoxItem}" TargetType="{x:Type ListBoxItem}">

                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="CategoryListBoxItem_PreviewMouseRightButtonDown"/>

                            <EventSetter Event="PreviewMouseDown" Handler="CategoryListBoxItem_PreviewMouseDown"/>

                            <EventSetter Event="PreviewMouseWheel" Handler="CategoryListBoxItem_PreviewMouseWheel"/>

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <TextBlock HorizontalAlignment="Stretch" Text="{qt:Resx Key=TabBar_Option_Genre}">

                                <TextBlock.Style>

                                    <Style TargetType="{x:Type TextBlock}">

                                        <Setter Property="qt:Resx.Index" Value="{Binding Path=Index}"/>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Border>



            <ScrollViewer

                Grid.Column="1"

                Background="{StaticResource Fluent.BackgroundBase}"

                HorizontalScrollBarVisibility="Disabled"

                VerticalScrollBarVisibility="Auto">

                <ContentControl Content="{Binding SelectedItem.Page, ElementName=lstCategories}"/>

            </ScrollViewer>

        </Grid>



        <Border

            Grid.Row="2"

            Padding="16,12"

            BorderBrush="{StaticResource Fluent.StrokeDefault}"

            BorderThickness="0,1,0,0">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">

                    <ui:Button

                        x:Name="btnResetPage"

                        Appearance="Secondary"

                        Click="btnResetPage_Click"

                        Content="{qt:Resx Key=DialogButtons, Index=4}"/>

                    <ui:Button

                        x:Name="btnResetAll"

                        Margin="8,0,0,0"

                        Appearance="Secondary"

                        Click="btnResetAll_Click"

                        Content="{qt:Resx Key=DialogButtons, Index=5}"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <ui:Button

                        x:Name="btnOK"

                        Appearance="Primary"

                        Click="btnOK_Click"

                        Content="{qt:Resx Key=DialogButtons, Index=0}"/>

                    <ui:Button

                        x:Name="btnCancel"

                        Margin="8,0,0,0"

                        Appearance="Secondary"

                        Click="btnCancel_Click"

                        Content="{qt:Resx Key=DialogButtons, Index=1}"/>

                    <ui:Button

                        x:Name="btnApply"

                        Margin="8,0,0,0"

                        Appearance="Secondary"

                        Click="btnApply_Click"

                        Content="{qt:Resx Key=DialogButtons, Index=2}"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</ui:FluentWindow>


