<?xml version="1.0" encoding="UTF-8"?>
<ui:FluentWindow
    x:Class="QTTabBarLib.OptionsFluentPoCWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:qt="clr-namespace:QTTabBarLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:ClassModifier="internal"
    ExtendsContentIntoTitleBar="True"
    Height="680"
    MinHeight="520"
    MinWidth="860"
    Title="QTTabBar Options — Fluent PoC"
    Width="960"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="/QTTabBar;component/OptionsDialog/Themes/FluentTheme.Light.xaml"/>
                <ResourceDictionary Source="/QTTabBar;component/OptionsDialog/Themes/FluentControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="QTTabBar Options — Fluent PoC"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource Fluent.BackgroundLayer}"
                BorderBrush="{StaticResource Fluent.StrokeDefault}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="navList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="navList_SelectionChanged">
                    <ListBoxItem Content="{qt:Resx Key=TabBar_Option_Genre, Index=0}" Tag="window"/>
                    <ListBoxItem Content="{qt:Resx Key=TabBar_Option_Genre, Index=1}" Tag="tabs"/>
                    <ListBoxItem Content="{qt:Resx Key=TabBar_Option_Genre, Index=2}" Tag="tweaks"/>
                </ListBox>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                Background="{StaticResource Fluent.BackgroundBase}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="pageHost"/>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="16,12"
            BorderBrush="{StaticResource Fluent.StrokeDefault}"
            BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Secondary"
                        Content="{qt:Resx Key=DialogButtons, Index=4}"/>
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Content="{qt:Resx Key=DialogButtons, Index=5}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Content="{qt:Resx Key=DialogButtons, Index=0}"/>
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Content="{qt:Resx Key=DialogButtons, Index=1}"/>
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Content="{qt:Resx Key=DialogButtons, Index=2}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
