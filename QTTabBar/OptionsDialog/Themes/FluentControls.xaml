<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="FluentPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fluent.PageTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="FluentPageDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fluent.PageDescriptionFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="FluentSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Fluent.SectionHeaderFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextPrimary}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="FluentCheckBox" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Fluent.TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FluentIndentedCheckBox" TargetType="CheckBox" BasedOn="{StaticResource FluentCheckBox}">
        <Setter Property="Margin" Value="20,4,0,4"/>
    </Style>

    <Style x:Key="FluentDialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="FluentDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentDialogButton}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FluentNavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,8"/>
    </Style>

    <Style x:Key="FluentNavListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fluent.BackgroundBase}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
